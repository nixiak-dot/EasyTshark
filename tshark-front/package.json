{
  "name": "tshark-front",
  "version": "1.1.0",
  "private": true,
  "main": "electron.js",
  "homepage": ".",
  "proxy": "http://127.0.0.1:8080",
  "dependencies": {
    "@arco-design/web-react": "^2.66.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.8.4",
    "echarts-for-react": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "electron . dev",
    "electron-build": "npm run build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.17",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "less": "^4.2.2",
    "less-loader": "^12.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.5"
  },
  "build": {
    "afterPack": "installer/after-pack.js",
    "asar": true,
    "appId": "MyTshark",
    "productName": "EasyTshark",
    "executableName": "EasyTshark",
    "directories": {
      "output": "dist"
    },
    "extraMetadata": {
      "main": "electron.js"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "resources/tshark_${os}",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "include": "installer/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    }
  }
}